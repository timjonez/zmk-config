#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        tabesc: tab_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp ESC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        colons: semicolon_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        quotes: singlequote_doublequote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        commalt: comma_lessthan {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LESS_THAN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        periodgt: period_greaterthan {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp GREATER_THAN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        minusunder: minus_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        shiftesc: shift_esc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RSHIFT>, <&kp ESC>;
            mods = <(MOD_LSFT)>;
        };
    };
};


/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
//    | TAB ESC | ; :   | , <    | . >     |  P  |  Y  |     |  F    |  G   |  C     |  R  |  L  | BKSP     |
//    | CTRL    |  A    |  O     |  E      |  U  |  I  |     |  D    |  H   |  T     |  N  |  S  | - _      |
//    | SHFT    | ' "   |  Q     |  J      |  K  |  X  |     |  B    |  M   |  W     |  V  |  Z  | SHFT ESC |
//                               | GUI     | LWR | SPC |     | ENT   | RSE  | ALT    |
                        bindings = <
   &tabesc      &colons &commalt &periodgt &kp P &kp Y       &kp F   &kp G  &kp C    &kp R &kp L &kp BSPC
   &kp LCTRL    &kp A   &kp O    &kp E     &kp U &kp I       &kp D   &kp H  &kp T    &kp N &kp S &minusunder
   &kp LSHFT    &quotes &kp Q    &kp J     &kp K &kp X       &kp B   &kp M  &kp W    &kp V &kp Z &shiftesc
                                 &kp LGUI  &mo 1 &kp SPACE   &kp RET &mo 2  &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// | F1 | F2   | F3   | F4     |F5      | F6   |        | HOME    |  7  |  8  |  9  |  /  | BKSP |
// |    | PLAY | STOP | VOL_DN | VOL_UP | MUTE |        | END     |  4  |  5  |  6  |  *  | -    |
// | F7 | F8   | F9   | F10    | F11    | F12  |        | DEL     |  1  |  2  |  3  |  .  | +    |
//                    | GUI    |        | SPC  |        | ENTER   |  0  | NUM |
                        bindings = <
   &kp F1 &kp F2           &kp F3      &kp F4       &kp F5       &kp F6       &kp HOME &kp KP_N7 &kp KP_N8  &kp KP_N9 &kp KP_SLASH    &kp BSPC1
   &trans &kp K_PLAY_PAUSE &kp K_STOP2 &bt K_VOL_DN &kp K_VOL_UP &kp K_MUTE   &kp END  &kp KP_N4 &kp KP_N5  &kp KP_N6 &kp KP_ASTERISK &kp KP_MINUS
   &kp F7 &kp F8           &kp F9      &kp F10      &kp F11      &kp F12      &kp DEL  &kp KP_N1 &kp KP_N2  &kp KP_N3 &kp KP_DOT      &kp KP_PLUS
                                       &kp LGUI     &trans       &kp SPACE    &kp RET  &kp KP_N0 &kp KP_NUM
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
        };
};
