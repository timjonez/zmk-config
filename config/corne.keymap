#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
    require-prior-idle-ms = <140>;
};

/ {
    behaviors {
        shiftesc: shift_esc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RSHIFT>, <&kp ESC>;

            mods = <(MOD_LSFT)>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        toggle_os {
            bindings = <&tog 1>;
            key-positions = <39 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        dvorak {
            // -----------------------------------------------------------------------------------------
            //    | TAB  | ; : | , <  | . > |  P  |  Y  |     |  F  |  G   |  C ⬆ |  R   |  L  | BKSP     |
            //    | CTRL |  A  |  O   |  E  |  U  |  I  |     |  D  |  H ⬅ |  T ⬇ |  N ⮕ |  S  | - _      |
            //    | SHFT | ' " |  Q   |  J  |  K  |  X  |     |  B  |  M   |  W   |  V   |  Z  | SHFT ESC |
            //                        | GUI | LWR | SPC |     | ENT | RSE  | ALT  |

            bindings = <
&kp ESCAPE    &kp SEMI        &kp COMMA       &kp DOT      &kp P        &kp Y        &kp F      &kp G        &kp C        &kp R            &kp L       &kp BSPC
&kp TAB       &mt LEFT_GUI A  &mt LEFT_ALT O  &mt LSHFT E  &mt LCTRL U  &kp I        &kp D      &mt RCTRL H  &mt RSHFT T  &mt RIGHT_ALT N  &mt RGUI S  &kp MINUS
&kp CAPSLOCK  &kp SQT         &kp Q           &kp J        &kp K        &kp X        &kp B      &kp M        &kp W        &kp V            &kp Z       &shiftesc
                                              &lt 5 LGUI   &mo 2        &kp SPACE    &lt 5 RET  &mo 3        &kp RALT
            >;
        };

        qwerty {
            bindings = <
&trans  &kp Q           &kp W            &kp E        &kp R        &kp T     &kp Y   &kp U        &kp I        &kp O            &kp P               &trans
&trans  &mt LEFT_GUI A  &mt RIGHT_ALT S  &mt LSHFT D  &mt LCTRL F  &kp G     &kp H   &mt RCTRL J  &mt RSHFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &trans
&trans  &kp Z           &kp X            &kp C        &kp V        &kp B     &kp N   &kp M        &kp COMMA    &kp PERIOD       &kp SLASH           &trans
                                         &trans       &mo 2        &trans    &trans  &mo 4        &trans
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // | F1   | F2   | F3   | F4     |F5      | F6   |        | HOME    |  7  |  8  |  9  |  /  | BKSP |
            // | SHFT | PLAY | STOP | VOL_DN | VOL_UP | MUTE |        | END     |  4  |  5  |  6  |  *  | -    |
            // | F7   | F8   | F9   | F10    | F11    | F12  |        | DEL     |  1  |  2  |  3  |  .  | +    |
            //                    | GUI    |        | SPC  |        | ENTER   |  0  | NUM |

            bindings = <
&kp F1     &kp F2            &kp F3       &kp F4        &kp F5        &kp F6        &kp HOME  &kp KP_N7  &kp KP_N8        &kp KP_N9  &kp KP_SLASH     &kp BSPC
&kp LSHFT  &kp C_PLAY_PAUSE  &kp K_STOP2  &kp K_VOL_DN  &kp K_VOL_UP  &kp K_MUTE    &kp END   &kp KP_N4  &kp KP_N5        &kp KP_N6  &kp KP_ASTERISK  &kp KP_MINUS
&kp F7     &kp F8            &kp F9       &kp F10       &kp F11       &kp F12       &kp DEL   &kp KP_N1  &kp KP_N2        &kp KP_N3  &kp KP_DOT       &kp KP_PLUS
                                          &kp LGUI      &trans        &kp SPACE     &kp RET   &kp KP_N0  &mt RALT KP_NUM
            >;
        };

        dvorak_sym {
            // -----------------------------------------------------------------------------------------
            // |  `   |  %  |  &  |  {  |  }   | #   |   | BTCLR | BT1 | BT2 | BT3 | BT5 | BKSP |
            // |  \   |  $  |  ?  |  (  |  )   | !   |   |   +   |  =  |  /  | "|" | \   | -    |
            // | SHFT | '   |  *  |  [  |  ]   | @   |   |   _   |  <  |  >  | ~   |  ^  | SHFT |
            //                    | GUI | BKSP | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp PRCNT  &kp AMPS   &kp LBRC  &kp RBRC  &kp HASH     &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp BSPC
&kp BSLH   &kp DLLR   &kp QMARK  &kp LPAR  &kp RPAR  &kp EXCL     &kp PLUS    &kp EQUAL     &kp SLASH     &kp PIPE      &kp BSLH      &kp MINUS
&kp LSHFT  &kp SQT    &kp ASTRK  &kp LBKT  &kp RBKT  &kp AT       &kp UNDER   &kp LT        &kp GT        &kp TILDE     &kp CARET     &kp RSHIFT
                                 &kp LGUI  &kp BSPC  &kp SPACE    &kp RET     &trans        &kp RALT
            >;
        };

        querty_sym {
            bindings = <
&kp GRAVE  &kp N5        &kp N7     &kp LEFT_BRACKET  &kp RBRC  &kp NUMBER_3    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp BSPC
&kp BSLH   &kp NUMBER_4  &kp SLASH  &kp N9            &kp N0    &kp NUMBER_1    &kp PLUS    &kp EQUAL     &kp SLASH     &kp PIPE      &kp BSLH      &kp MINUS
&kp LSHFT  &kp SQT       &kp N8     &kp LBKT          &kp RBKT  &kp NUMBER_2    &kp UNDER   &kp LT        &kp GT        &kp TILDE     &kp CARET     &kp RSHIFT
                                    &kp LGUI          &kp BSPC  &kp SPACE       &kp RET     &trans        &kp RALT
            >;
        };

        shortcuts {
            bindings = <
&trans  &trans  &kp LC(SLASH)  &kp LC(S)  &trans         &trans      &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans         &kp LC(C)  &kp LC(Z)      &trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans         &kp LC(V)  &kp LC(LS(Z))  &trans      &trans  &trans          &trans          &trans           &trans  &kp RSHIFT
                               &kp RALT   &kp BSPC       &kp LGUI    &trans  &trans          &trans
            >;
        };
    };
};
